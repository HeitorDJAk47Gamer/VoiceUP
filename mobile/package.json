{
  "name": "voiceup-mobile",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "Cliente Android experimental do VoiceUP, feito em React e Capacitor.",
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.mjs",
    "build": "vite build",
    "sync": "npm run build && npx cap sync android",
    "android": "npx cap open android",
    "apk:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-apk.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.7"
  }
}
