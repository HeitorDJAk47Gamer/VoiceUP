# Copie somente as opcoes necessarias para o painel da hospedagem.
# Gere um token aleatorio de pelo menos 24 caracteres e nunca o publique.
VOICEUP_ADMIN_TOKEN=troque-por-um-token-aleatorio-longo

VOICEUP_DATA_DIR=./data
VOICEUP_CHAT_RETENTION_DAYS=30
VOICEUP_CHAT_MAX_PER_ROOM=300
VOICEUP_MAX_HUMANS_PER_CALL=12
VOICEUP_MAX_MEMBERS_PER_CALL=15
VOICEUP_MAX_IDENTITIES=50000

# Origens adicionais, separadas por virgula. O site oficial e localhost ja sao aceitos.
VOICEUP_ALLOWED_ORIGINS=

# Hashes SHA-256 completos de plugins externos aprovados, separados por virgula.
VOICEUP_TRUSTED_PLUGIN_HASHES=

# Objeto JSON. Prefira senhas no formato scrypt descrito no README.
VOICEUP_ROOM_PASSWORDS={}
